#!/usr/bin/env python3
"""Deterministic fake Omarchy notification command."""

import json
import os
import sys
from pathlib import Path


destination = os.environ.get("ORDERBELL_FAKE_OMARCHY_LOG")
if destination:
    with Path(destination).open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(sys.argv[1:], ensure_ascii=False, separators=(",", ":")) + "\n")

sys.stdout.write(os.environ.get("ORDERBELL_FAKE_OMARCHY_STDOUT", ""))
sys.stderr.write(os.environ.get("ORDERBELL_FAKE_OMARCHY_STDERR", ""))
raise SystemExit(int(os.environ.get("ORDERBELL_FAKE_OMARCHY_RC", "0")))
